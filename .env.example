# Optional settings for docker-compose.yml. Copy to .env and uncomment what you need.
# Everything here has a working default for a single-machine install.

# --- Passwords (change these if any port is reachable from other machines) ---
# MEOWBERT_POSTGRES_PASSWORD=postgres
# MEOWBERT_REDIS_PASSWORD=
# MEOWBERT_MEILISEARCH_MASTER_KEY=meowbert-meilisearch

# --- Where data is stored on the host ---
# MEOWBERT_POSTGRES_DATA_PATH=/data/meowbert/postgres-data
# MEOWBERT_POSTGRES_BACKUP_PATH=/data/meowbert/postgres-backups
# MEOWBERT_MEILISEARCH_DATA_PATH=/srv/meowbert/runtime/meilisearch

# --- Skill API keys ---
# Brave Search key for the Deep AI Search skill.
# BRAVE_API_KEY=
# Key for the provider configured in skills/deep-ai-search/deep-ai-search.config.json.
# OPENAI_API_KEY=
# Key for the provider configured in skills/image-generation/image-generation.config.json.
# IMAGE_GEN_SKILL_API_KEY=

# --- Sandbox image ---
# Pin a specific published tag, or point at your own build (for custom skills).
# MEOWBERT_SANDBOX_RUNTIME_IMAGE=ghcr.io/xinthedark/meowbert-ai-agent/sandbox-runtime:main

# --- Outgoing email (only with `docker compose -f docker-compose.full.yml up -d`) ---
# LISTMONK_ADMIN_USER=listmonk
# LISTMONK_ADMIN_PASSWORD=listmonk

# --- Reaching Meowbert from other machines (rebuild web after changing) ---
# VITE_API_URL=https://api.meowbert.example.com
# VITE_ALLOWED_HOSTS=meowbert.example.com
