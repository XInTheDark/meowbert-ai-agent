{
  "name": "@meowbert/desktop",
  "version": "2026.10.32",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build --workspace @meowbert/shared && npm run build --workspace @meowbert/run-executor && electron-vite build && node scripts/build-host-skills.mjs && node scripts/build-live-folder-runtime.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs",
    "package:release": "npm run build && electron-builder --config electron-builder.config.cjs --publish always",
    "test": "vitest run"
  },
  "dependencies": {
    "@meowbert/run-executor": "0.1.0",
    "@meowbert/shared": "0.1.0",
    "dockerode": "5.0.1",
    "electron-updater": "6.8.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "@playwright/mcp": "0.0.68",
    "playwright": "1.59.0-alpha-1771104257000",
    "archiver": "7.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "42.11.16",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "@types/archiver": "7.0.0"
  },
  "description": "Meowbert Desktop",
  "author": "Meowbert"
}
